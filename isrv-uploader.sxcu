{
  "Version": "19.0.2",
  "Name": "iSRV",
  "DestinationType": "ImageUploader, FileUploader",
  "RequestMethod": "POST",
  "RequestURL": "https://isrv.nl",
  "Headers": {
    "X-Uploader": "Sharex"
  },
  "Body": "MultipartFormData",
  "FileFormName": "file",
  "URL": "{json:shortUrl}",
  "ThumbnailURL": "[img]{json:shortUrl}[/img]"
}
